@import "config.rasi"

* {
    alternate-normal-background:    @background;
    active-background:              @lightbg;
    active-foreground:              @foreground;
}

configuration {
    modi:                           "drun";
    show-icons:                     false;
    display-drun:                   "";
    drun-display-format:            "{name} [<span weight='light' size='small'><i>({generic})</i></span>]";
    window-format:                  "{w} · {c} · {t}";
}

window {
    transparency:                   "real";
    location:                       center;
    anchor:                         center;
    fullscreen:                     false;
    width:                          500px;
    x-offset:                       0px;
    y-offset:                       0px;
    enabled:                        true;
    margin:                         0px;
    padding:                        0px;
    border:                         2px solid;
    border-radius:                  5px;
    cursor:                         "default";
}

mainbox {
    enabled:                        true;
    spacing:                        10px;
    margin:                         0px;
    padding:                        20px;
    border:                         0px solid;
    border-radius:                  0px 0px 0px 0px;
    children:                       [ "inputbar", "listview" ];
}

inputbar {
    enabled:                        true;
    spacing:                        10px;
    margin:                         0px;
    padding:                        7px;
    border:                         0px;
    border-radius:                  5px;
    border:                         1px solid;
    children:                       [ "prompt", "entry" ];
}

prompt {
    enabled:                        true;
}

textbox-prompt-colon {
    enabled:                        true;
    expand:                         false;
    str:                            "::";
}

entry {
    enabled:                        true;
    cursor:                         text;
    placeholder:                    "";
}

listview {
    enabled:                        true;
    columns:                        1;
    lines:                          8;
    cycle:                          true;
    dynamic:                        true;
    scrollbar:                      false;
    layout:                         vertical;
    reverse:                        false;
    fixed-height:                   true;
    fixed-columns:                  true;
    
    spacing:                        0px;
    margin:                         0px;
    padding:                        0px;
    border:                         0px solid;
    border-radius:                  0px;
    background-color:               transparent;
    cursor:                         "default";
}

scrollbar {
    handle-width:                   5px ;
    border-radius:                  0px;
}

element {
    enabled:                        true;
    spacing:                        10px;
    margin:                         0px;
    padding:                        5px;
    border:                         0px solid;
    border-radius:                  5px;
    background-color:               transparent;
    cursor:                         pointer;
}

element-icon {
    background-color:               transparent;
    size:                           24px;
}

element-text {
    background-color:               transparent;
    vertical-align:                 0.5;
    horizontal-align:               0.0;
}
